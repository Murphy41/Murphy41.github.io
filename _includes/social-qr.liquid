<button
  type="button"
  class="social-qr-trigger"
  title="Xiaohongshu / RED"
  aria-label="Xiaohongshu / RED — show QR code"
  aria-haspopup="dialog"
  aria-controls="xiaohongshu-dialog"
>
  {% include social-icons/xiaohongshu.liquid %}
</button>
<dialog id="xiaohongshu-dialog" class="social-qr-modal" aria-label="Xiaohongshu profile QR code">
  <form method="dialog">
    <button class="social-qr-close" aria-label="Close" autofocus>×</button>
  </form>
  <img
    src="{{ site.data.xiaohongshu.qr_image | relative_url }}"
    alt="Xiaohongshu profile card with QR code and account details"
    class="social-qr-image"
  >
</dialog>
<script defer src="{{ '/assets/js/social-qr.js' | relative_url | bust_file_cache }}"></script>
